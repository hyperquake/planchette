{
  "name": "planchette",
  "productName": "Planchette",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Simulator for a multitouch table with tangible pucks, plus an SDK for designer-authored HTML interfaces.",
  "author": "Hyperquake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Potion/planchette.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean.mjs",
    "build": "vite build && vite build --config vite.sdk.config.ts && vite build --config vite.vendor.config.ts",
    "build:types": "tsc -p tsconfig.sdk.json",
    "build:seed": "npm run build:types && node scripts/build-seed.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "release:body": "node scripts/release-body.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:dev": "electron . --dev-url=http://localhost:5173",
    "prepackage": "npm run build && npm run build:seed",
    "dist": "npm run prepackage && electron-builder",
    "dist:mac": "npm run prepackage && electron-builder --mac",
    "dist:win": "npm run prepackage && electron-builder --win",
    "smoke": "node scripts/smoke-desktop.mjs",
    "smoke:embed": "node scripts/smoke-embed.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "main": "electron/main.js",
  "allowScripts": {
    "electron@43.4.1": true
  }
}
